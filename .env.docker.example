# Copy to .env before deploying with docker compose, or paste into xCloud's environment editor.

# Every site on the same VPS needs its own two ports. Pick unused ones, e.g.
# 6000/8081 for the first site, 6010/8091 for the next. `npm run deploy`
# refuses to start if either is taken and suggests a free one.
# APP_PORT is what xCloud's domain proxy points at; ADMINER_PORT is only
# reachable from the VPS itself.
APP_PORT=6000
ADMINER_PORT=8081
NEXT_PUBLIC_SITE_URL=http://localhost:6000

# Only needed with docker-compose.xcloud.yml. `npm run deploy` sets it for you.
# CMS_IMAGE=aviva-cms:0.1.4

# Generate with: npm run cms:secret
CMS_SESSION_SECRET=

# Change these before putting the stack on a public VPS.
POSTGRES_DB=cms
POSTGRES_USER=cms
POSTGRES_PASSWORD=change_me
