# Copy to .env before deploying with docker compose, or paste into xCloud's environment editor.

APP_PORT=6000
NEXT_PUBLIC_SITE_URL=http://localhost:6000

# Only needed with docker-compose.xcloud.yml. `npm run deploy` sets it for you.
# CMS_IMAGE=aviva-cms:0.1.4

# Generate with: npm run cms:secret
CMS_SESSION_SECRET=

# Change these before putting the stack on a public VPS.
POSTGRES_DB=cms
POSTGRES_USER=cms
POSTGRES_PASSWORD=change_me
