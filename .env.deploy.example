# Copy to .env.deploy (never committed) for `npm run deploy`.
# The SSH user must be able to run docker on the VPS: test with
#   ssh -p 22 USER@HOST docker ps
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PORT=22
# The site folder that holds .env and docker-compose.yml.
DEPLOY_DIR=/var/www/your-site.xc1.app
# Match the VPS CPU. Use linux/arm64 for ARM servers.
DEPLOY_PLATFORM=linux/amd64
